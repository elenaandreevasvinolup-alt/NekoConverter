<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MathGeo.App.Controls"
        x:Class="MathGeo.App.MainWindow"
        Width="1280" Height="820"
        MinWidth="880" MinHeight="600"
        Background="{DynamicResource AppBackground}"
        Title="MathGeo">

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

      <!-- ————————————————— 侧栏 ————————————————— -->
      <Border Grid.Column="0" Width="240"
              Background="{DynamicResource SidebarBackground}"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <StackPanel Grid.Row="0" Margin="20,24,20,16" Spacing="3">
            <TextBlock x:Name="BrandTitle" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="BrandSubtitle" Classes="hint" />
          </StackPanel>

          <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="12,0">
            <Button x:Name="OpenFolderButton" Grid.Row="0" Classes="primary"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,0,0,10" />
            <ListBox x:Name="ProblemList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0" />
          </Grid>

          <StackPanel Grid.Row="2" Margin="12,12,12,18" Spacing="8">
            <TextBlock x:Name="ThemeLabel" Classes="hint" />
            <Button x:Name="ThemeButton" Classes="ghost"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBlock x:Name="LanguageLabel" Classes="hint" />
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" />

            <!--
              显示设置单独折叠在一边，和"系统设置"分开：
              老师会一边调一边看效果，折叠起来就不占地方。
              这些设置只影响本机的显示，不写进题目文件。
            -->
            <Expander x:Name="DisplayPanel" IsExpanded="False" Margin="0,6,0,0">
              <StackPanel Spacing="6">
                <CheckBox x:Name="GridCheck" IsChecked="True" />
                <CheckBox x:Name="InvertYCheck" IsChecked="False" />

                <TextBlock x:Name="LabelSizeLabel" Classes="hint" Margin="0,6,0,0" />
                <Slider x:Name="LabelSizeSlider" Minimum="0.6" Maximum="1.8"
                        Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" />

                <TextBlock x:Name="PointSizeLabel" Classes="hint" Margin="0,6,0,0" />
                <Slider x:Name="PointSizeSlider" Minimum="0.5" Maximum="2.5"
                        Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" />
              </StackPanel>
            </Expander>
          </StackPanel>

        </Grid>
      </Border>

      <!-- ————————————————— 内容 ————————————————— -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto">

        <!-- 画布：套一层 Border 是为了拿到圆角，同时保证空白处也能接住指针事件。 -->
        <Border x:Name="CanvasHost" Grid.Row="0" Margin="16,16,16,0"
                CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1">
          <Grid>
            <controls:SceneView x:Name="Canvas" />
            <!-- 视角立方体浮在画布右上角 -->
            <controls:ViewCube x:Name="ViewCube"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,8,8,0" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Margin="16,12,16,16">
          <StackPanel Spacing="10">

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock x:Name="ProblemTitle" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="ProblemStatement" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Button x:Name="ExportButton" Grid.Column="1" Classes="ghost"
                      VerticalAlignment="Top" Margin="12,0,0,0" />
            </Grid>

            <!-- 视图预设：只在三维场景出现。讲课要的就是这几个固定角度。 -->
            <StackPanel x:Name="ViewPresetRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
              <Button x:Name="ViewTextbook" Classes="pill" />
              <Button x:Name="ViewFront" Classes="pill" />
              <Button x:Name="ViewTop" Classes="pill" />
              <Button x:Name="ViewSide" Classes="pill" />
              <Button x:Name="ViewIsometric" Classes="pill" />
              <Button x:Name="ViewThreeViews" Classes="pill" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="PlayButton" Grid.Column="0" Classes="primary" />
              <Slider x:Name="FrameSlider" Grid.Column="1" Margin="14,0"
                      Minimum="0" Maximum="0" Value="0" />
              <TextBlock x:Name="FrameCounter" Grid.Column="2" Classes="label"
                         MinWidth="90" TextAlignment="Right" />
            </Grid>

            <Border x:Name="AnswerBox" IsVisible="False"
                    CornerRadius="8" Padding="12,10"
                    Background="{DynamicResource AccentSoft}">
              <StackPanel Spacing="4">
                <TextBlock x:Name="AnswerValue" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Accent}" />
                <ItemsControl x:Name="AnswerSteps">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                 Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextSecondary}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock x:Name="HintText" Classes="hint" />

          </StackPanel>
        </Border>

      </Grid>
    </Grid>

  </Grid>
</Window>
