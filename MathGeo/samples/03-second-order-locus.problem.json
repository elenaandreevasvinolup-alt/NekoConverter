  "ask": { "target": "MD", "measure": "length" },
  "answer": {
    "value": "以 OA 中点 M 为圆心、半径 1 的圆",
    "steps": ["D 是 AC 中点", "MD 是 △AOC 的中位线，MD = OC/2 = 1"]
  }
