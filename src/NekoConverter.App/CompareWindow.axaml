<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NekoConverter.App.CompareWindow"
        Title="NekoConverter"
        Width="900" Height="620"
        MinWidth="600" MinHeight="420"
        Background="{DynamicResource AppBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20" >

    <!-- Итог по размеру: главное число при проверке потерь -->
    <Border Grid.Row="0" Classes="card" Margin="0,0,0,14">
      <StackPanel Spacing="6">
        <TextBlock x:Name="TitleText" Text="" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock x:Name="SizeChangeText" Text="" FontSize="13"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </Border>

    <!-- Две стороны: исходное и результат -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="OriginalTitleText" Text=""
                     FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />

          <Border DockPanel.Dock="Top" x:Name="OriginalImageFrame" IsVisible="False"
                  BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                  CornerRadius="6" Padding="4" Margin="0,10,0,0"
                  Background="{DynamicResource SubtleBackground}"
                  HorizontalAlignment="Left">
            <Image x:Name="OriginalImage" MaxWidth="340" MaxHeight="300" Stretch="Uniform" />
          </Border>

          <TextBlock DockPanel.Dock="Top" x:Name="OriginalMetaText" Text=""
                     Classes="hint" Margin="0,10,0,0" />

          <ScrollViewer Margin="0,10,0,0">
            <SelectableTextBlock x:Name="OriginalLinesText" Text=""
                                 FontFamily="Menlo, Consolas, monospace" FontSize="11"
                                 Foreground="{DynamicResource TextPrimary}"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="ResultTitleText" Text=""
                     FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />

          <Border DockPanel.Dock="Top" x:Name="ResultImageFrame" IsVisible="False"
                  BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                  CornerRadius="6" Padding="4" Margin="0,10,0,0"
                  Background="{DynamicResource SubtleBackground}"
                  HorizontalAlignment="Left">
            <Image x:Name="ResultImage" MaxWidth="340" MaxHeight="300" Stretch="Uniform" />
          </Border>

          <TextBlock DockPanel.Dock="Top" x:Name="ResultMetaText" Text=""
                     Classes="hint" Margin="0,10,0,0" />

          <ScrollViewer Margin="0,10,0,0">
            <SelectableTextBlock x:Name="ResultLinesText" Text=""
                                 FontFamily="Menlo, Consolas, monospace" FontSize="11"
                                 Foreground="{DynamicResource TextPrimary}"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="RevealButton" Content="" Classes="ghost" />
      <Button x:Name="CloseButton" Content="" Classes="primary" />
    </StackPanel>

  </Grid>
</Window>
