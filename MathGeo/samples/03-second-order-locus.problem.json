    { "id": "OA", "type": "segment", "a": "O", "b": "A" },
    { "id": "M", "type": "point", "derived": "midpoint", "args": ["O", "A"], "label": "M" },
    { "id": "MD", "type": "segment", "a": "M", "b": "D", "style": "answer" }
