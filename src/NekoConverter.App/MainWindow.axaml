<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoConverter.App"
        x:Class="NekoConverter.App.MainWindow"
        Title="NekoConverter"
        Width="1180"
        Height="760"
        MinWidth="380"
        MinHeight="520">

  <!--
    Окно ничего не делает само: вся вёрстка и логика живут в MainView.

    Разделение нужно ради телефонов: там окна как такового нет, есть одно
    представление на весь экран, и показать Window система не даёт. Один и тот же
    MainView годится и для окна, и для экрана — дублировать интерфейс не приходится.
  -->
  <local:MainView />

</Window>
