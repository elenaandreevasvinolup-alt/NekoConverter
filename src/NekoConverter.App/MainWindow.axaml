<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NekoConverter.App.MainWindow"
        Title="NekoConverter"
        Width="940" Height="700"
        MinWidth="320" MinHeight="420"
        Background="{DynamicResource AppBackground}">

  <Window.Resources>
    <!-- Отступ содержимого. Меняется из кода при переходе к компактной вёрстке. -->
    <Thickness x:Key="PageMargin">28,24,28,28</Thickness>
  </Window.Resources>

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

    <!-- ═══════════════ Боковое меню (широкий экран) ═══════════════ -->
    <Border x:Name="SidebarPanel" Grid.Column="0" Width="208"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="18,22,18,18" Spacing="2">
          <TextBlock Text="NekoConverter" FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Text="{DynamicResource Loc.app.subtitle}" FontSize="11"
                     Foreground="{DynamicResource TextTertiary}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10,0" Spacing="2">
          <Button x:Name="NavConvert" Classes="nav">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⇄" />
              <TextBlock Text="{DynamicResource Loc.nav.convert}" />
            </StackPanel>
          </Button>
          <Button x:Name="NavModules" Classes="nav">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="▦" />
              <TextBlock Text="{DynamicResource Loc.nav.modules}" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Classes="nav">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⚙" />
              <TextBlock Text="{DynamicResource Loc.nav.settings}" />
            </StackPanel>
          </Button>
          <Button x:Name="NavAbout" Classes="nav">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="ⓘ" />
              <TextBlock Text="{DynamicResource Loc.nav.about}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10,0,10,16" Spacing="6">
          <!-- Текст ставится из кода: он зависит и от языка, и от текущей темы. -->
          <Button x:Name="ThemeQuickToggle" Classes="nav" />

          <!-- Индикатор сети: видно, дойдут ли пакеты-зависимости.
               На работу встроенных форматов недоступность сети не влияет. -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,2,14,0">
            <Ellipse x:Name="NetworkDot" Width="8" Height="8"
                     Fill="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
            <TextBlock x:Name="NetworkText" Text="" FontSize="11"
                       Foreground="{DynamicResource TextTertiary}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ═══════════════ Содержимое ═══════════════ -->
    <Grid Grid.Column="1">

      <!-- ─────── Страница «转换» ─────── -->
      <ScrollViewer x:Name="ConvertPage">
        <StackPanel Margin="{DynamicResource PageMargin}" Spacing="14">

          <TextBlock Text="{DynamicResource Loc.convert.title}" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}" />

          <!-- Пустое состояние: ни выбора формата, ни настроек, только одна строка. -->
          <Panel x:Name="EmptyState" MinHeight="300">
            <Rectangle x:Name="DropZoneShape" Classes="dropzone"
                       RadiusX="12" RadiusY="12" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
              <TextBlock x:Name="DropGlyph" Text="⬇" FontSize="34"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextTertiary}" />
              <TextBlock x:Name="DropTitle" Text="{DynamicResource Loc.drop.select_or_drop}"
                         FontSize="15" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock x:Name="DropHint" Text=""
                         FontSize="11" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextTertiary}" />
              <Button x:Name="PickFileButton" Content="{DynamicResource Loc.pick.button}" Classes="primary"
                      HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>

          <!-- Состояние с загруженными файлами -->
          <StackPanel x:Name="FileState" Spacing="14" IsVisible="False">

            <!-- Список файлов и способы их добавить -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="FilesSummaryText" Grid.Column="0" Text=""
                             FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddFilesButton" Content="{DynamicResource Loc.files.add}" Classes="ghost" />
                    <Button x:Name="ClearFilesButton" Content="{DynamicResource Loc.files.clear}" Classes="ghost" />
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="FilesListText" Text="" Classes="hint" />

                <!-- Строка ввода: путь к файлу или ссылка. Картинку можно
                     вставить из буфера прямо в это поле. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox x:Name="SourceInputBox" Width="420" MinHeight="34"
                           Watermark="{DynamicResource Loc.input.watermark}" />
                  <Button x:Name="AddFromInputButton" Content="{DynamicResource Loc.input.add}" Classes="ghost" />
                  <Button x:Name="PasteImageButton" Content="{DynamicResource Loc.input.paste}" Classes="ghost" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Предпросмотр первого файла пакета -->
            <Border x:Name="PreviewCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Loc.preview.title}" Classes="cardTitle" />

                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Border x:Name="PreviewImageFrame" IsVisible="False"
                          BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                          CornerRadius="6" Padding="4"
                          Background="{DynamicResource SubtleBackground}">
                    <Image x:Name="PreviewImage" MaxWidth="180" MaxHeight="180" Stretch="Uniform" />
                  </Border>

                  <StackPanel Spacing="6" VerticalAlignment="Top">
                    <TextBlock x:Name="PreviewSummaryText" Text=""
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="PreviewLinesText" Text=""
                                         FontFamily="Menlo, Consolas, monospace" FontSize="11"
                                         Foreground="{DynamicResource TextPrimary}"
                                         TextWrapping="Wrap" MaxWidth="520" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Общие настройки вывода: одинаковы для всех групп -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Loc.output.title}" Classes="cardTitle" />

                <CheckBox x:Name="UseCustomOutput" Content="{DynamicResource Loc.output.custom}" />

                <StackPanel x:Name="CustomOutputPanel" Spacing="8" IsVisible="False">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="PickOutputFolderButton"
                            Content="{DynamicResource Loc.output.pick}" Classes="ghost" />
                    <TextBlock x:Name="OutputFolderText" Text=""
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{DynamicResource Loc.output.template}" Classes="label" />
                  <TextBox x:Name="NameTemplateBox" Width="220" MinHeight="34"
                           Text="{DynamicResource Loc.output.template_default}" />
                </StackPanel>

                <TextBlock x:Name="TemplateTokensText" Text="" Classes="hint" />
              </StackPanel>
            </Border>

            <!-- Группы файлов: по карточке на категорию, строятся в коде -->
            <StackPanel x:Name="GroupList" Spacing="12" />

            <Button x:Name="ConvertAllButton" Content="{DynamicResource Loc.convert.all}"
                    Classes="primary" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,12" FontSize="15" />

            <!-- Общий прогресс пакета -->
            <Border x:Name="BatchProgressCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock x:Name="BatchProgressText" Text="" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}" />
                <ProgressBar x:Name="BatchProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" />
              </StackPanel>
            </Border>

          </StackPanel>

          <Border x:Name="StatusCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="6">
              <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource TextPrimary}" />
              <TextBlock x:Name="StatusDetailText" Text="" Classes="hint" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ─────── Страница «模块» ─────── -->
      <ScrollViewer x:Name="ModulesPage" IsVisible="False">
        <StackPanel Margin="{DynamicResource PageMargin}" Spacing="14">
          <TextBlock Text="{DynamicResource Loc.modules.title}" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}" />

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ModulesSummaryText" Text="" TextWrapping="Wrap"
                         FontSize="13" Foreground="{DynamicResource TextPrimary}" />
              <TextBlock Classes="hint" Text="{DynamicResource Loc.modules.dep_hint}" />
              <TextBlock Classes="hint" Text="{DynamicResource Loc.modules.offline_hint}" />
            </StackPanel>
          </Border>

          <StackPanel x:Name="PackageList" Spacing="12" />

          <!-- MCP: тот же бинарник умеет работать сервером для ИИ-ассистентов -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource Loc.mcp.title}" Classes="cardTitle" />
              <TextBlock Classes="hint" Text="{DynamicResource Loc.mcp.body}" />

              <Border Background="{DynamicResource SubtleBackground}" CornerRadius="6" Padding="12">
                <SelectableTextBlock x:Name="McpConfigText" Text=""
                                     FontFamily="Menlo, Consolas, monospace" FontSize="11"
                                     TextWrapping="Wrap" />
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CopyMcpConfigButton"
                        Content="{DynamicResource Loc.mcp.copy}" Classes="ghost" />
                <TextBlock x:Name="McpToolsText" Text="" Classes="hint"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ─────── Страница «设置» ─────── -->
      <ScrollViewer x:Name="SettingsPage" IsVisible="False">
        <StackPanel Margin="{DynamicResource PageMargin}" Spacing="14">
          <TextBlock Text="{DynamicResource Loc.settings.title}" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}" />

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="{DynamicResource Loc.settings.theme}" Classes="cardTitle" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ThemeLight" Classes="pill" Content="{DynamicResource Loc.settings.theme_light}" />
                <Button x:Name="ThemeDark" Classes="pill" Content="{DynamicResource Loc.settings.theme_dark}" />
                <Button x:Name="ThemeSystem" Classes="pill" Content="{DynamicResource Loc.settings.theme_system}" />
                <Button x:Name="ThemeByTime" Classes="pill" Content="{DynamicResource Loc.settings.theme_bytime}" />
              </StackPanel>
              <TextBlock Classes="hint" Margin="0,12,0,0"
                         Text="{DynamicResource Loc.settings.theme_hint}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="{DynamicResource Loc.settings.data_dir}" Classes="cardTitle" />
              <TextBlock x:Name="DataDirectoryText" Text="" Classes="hint" />
              <TextBlock Classes="hint" Margin="0,8,0,0"
                         Text="{DynamicResource Loc.settings.data_dir_hint}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Loc.preview.settings}" Classes="cardTitle" />
              <TextBlock Classes="hint" Text="{DynamicResource Loc.preview.settings_hint}" />

              <StackPanel Spacing="2" Margin="0,8,0,0">
                <CheckBox x:Name="PreviewThumbnail" Content="{DynamicResource Loc.preview.thumbnail}" />
                <CheckBox x:Name="PreviewText" Content="{DynamicResource Loc.preview.text}" />
                <CheckBox x:Name="PreviewAudio" Content="{DynamicResource Loc.preview.audio}" />
                <CheckBox x:Name="PreviewMedia" Content="{DynamicResource Loc.preview.media}" />
                <CheckBox x:Name="PreviewMesh" Content="{DynamicResource Loc.preview.mesh}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="{DynamicResource Loc.settings.language}" Classes="cardTitle" />
              <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ─────── Страница «关于» ─────── -->
      <ScrollViewer x:Name="AboutPage" IsVisible="False">
        <StackPanel Margin="{DynamicResource PageMargin}" Spacing="14">
          <TextBlock Text="{DynamicResource Loc.about.title}" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}" />

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="NekoConverter" Classes="cardTitle" />
              <TextBlock x:Name="AboutVersionText" Text="" Classes="hint" />
              <TextBlock Classes="hint" Margin="0,8,0,0" Text="{DynamicResource Loc.about.body}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Loc.about.engines}" Classes="cardTitle" />

              <TextBlock x:Name="BuiltinEnginesTitle" Classes="engineGroup" />
              <StackPanel x:Name="BuiltinEngineList" Spacing="2" />

              <TextBlock x:Name="ModuleEnginesTitle" Classes="engineGroup" Margin="0,14,0,0" />
              <StackPanel x:Name="ModuleEngineList" Spacing="2" />

              <TextBlock x:Name="NoModuleEnginesText" Classes="hint" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="{DynamicResource Loc.about.license}" Classes="cardTitle" />
              <TextBlock x:Name="LicenseText" Text="{DynamicResource Loc.about.license_body}" Classes="hint" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

    </Grid>

    </Grid>

    <!-- ═══════════════ Нижняя навигация (узкий экран) ═══════════════ -->
    <!-- На телефоне боковое меню занимает четверть ширины и мешает,
         поэтому там навигация переезжает вниз, под большой палец. -->
    <Border x:Name="BottomNav" Grid.Row="1" IsVisible="False"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,*,*,*">
        <Button x:Name="TabConvert" Grid.Column="0" Classes="bottomnav">
          <StackPanel Spacing="2">
            <TextBlock Text="⇄" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Loc.nav.convert}" FontSize="10" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="TabModules" Grid.Column="1" Classes="bottomnav">
          <StackPanel Spacing="2">
            <TextBlock Text="▦" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Loc.nav.modules}" FontSize="10" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="TabSettings" Grid.Column="2" Classes="bottomnav">
          <StackPanel Spacing="2">
            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Loc.nav.settings}" FontSize="10" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="TabAbout" Grid.Column="3" Classes="bottomnav">
          <StackPanel Spacing="2">
            <TextBlock Text="ⓘ" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Loc.nav.about}" FontSize="10" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

  </Grid>
</Window>
